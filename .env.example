APP_NAME=Obsidian Learning Agent
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
ADMIN_ENABLED=true
DATABASE_REQUIRED_ON_STARTUP=false
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=rag_knowledge_base
DATABASE_URL=

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
QDRANT_PREFER_GRPC=true
QDRANT_GRPC_PORT=6334

EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=5

RAG_REWRITE_ENABLED=true
RAG_REWRITE_SCORE_THRESHOLD=0.45
RAG_REWRITE_MIN_RESULTS=2
RAG_REWRITE_SHORT_QUERY_LENGTH=4
RAG_CONTEXT_MAX_CHARS=12000
RAG_MAX_CHUNKS_PER_SOURCE=3
LEARNING_SESSION_REVIEW_MAX_QA=20

SESSION_MEMORY_ENABLED=true
SESSION_MEMORY_MAX_TURNS=6
SESSION_MEMORY_MAX_CHARS=3000
SESSION_MEMORY_ANSWER_PREVIEW_CHARS=500

USER_PREFERENCES_MAX_CHARS=1000
EXPLICIT_LEARNING_CONTEXT_MAX_CHARS=1200
RAG_TOTAL_PROMPT_MAX_CHARS=18000

RUN_HISTORY_RETENTION_DAYS=10
RUN_QUESTION_PREVIEW_CHARS=200
RUN_ERROR_PREVIEW_CHARS=500

TOOL_DEFAULT_TIMEOUT_SECONDS=15
TOOL_AUDIT_INPUT_MAX_CHARS=1000
TOOL_AUDIT_OUTPUT_MAX_CHARS=1000
ENABLED_INTERNAL_TOOLS=list_learning_goals,list_learning_status,search_obsidian_notes,get_session_messages,get_user_preferences,retrieve_knowledge

OBSIDIAN_ENABLED=false
OBSIDIAN_VAULT_PATH=
OBSIDIAN_INCLUDE_PATTERNS=*.md,**/*.md
OBSIDIAN_EXCLUDE_DIRS=.obsidian,.trash,Attachments,Templates,Archive,_ai_updates
OBSIDIAN_EXCLUDE_PATHS=Learning/_drafts
OBSIDIAN_MAX_FILE_BYTES=2097152
OBSIDIAN_CHUNK_MIN_CHARS=200
OBSIDIAN_CHUNK_TARGET_CHARS=1200
OBSIDIAN_CHUNK_MAX_CHARS=1800
OBSIDIAN_ATOMIC_BLOCK_HARD_MAX_CHARS=6000

# Optional project-local caches for future model downloads.
HF_HOME=model_cache/huggingface
TRANSFORMERS_CACHE=model_cache/huggingface/transformers
SENTENCE_TRANSFORMERS_HOME=model_cache/sentence-transformers

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
