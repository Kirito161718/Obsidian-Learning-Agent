APP_NAME=Obsidian Learning Agent
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
ADMIN_ENABLED=true
DATABASE_REQUIRED_ON_STARTUP=false
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=rag_knowledge_base
DATABASE_URL=

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
QDRANT_PREFER_GRPC=true
QDRANT_GRPC_PORT=6334

EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=5

# Optional project-local caches for future model downloads.
HF_HOME=model_cache/huggingface
TRANSFORMERS_CACHE=model_cache/huggingface/transformers
SENTENCE_TRANSFORMERS_HOME=model_cache/sentence-transformers

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
