APP_NAME=Obsidian Learning Agent
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
ADMIN_ENABLED=true
DATABASE_REQUIRED_ON_STARTUP=false
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=rag_knowledge_base
DATABASE_URL=

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
QDRANT_PREFER_GRPC=true
QDRANT_GRPC_PORT=6334

EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=5

RAG_REWRITE_ENABLED=true
RAG_REWRITE_SCORE_THRESHOLD=0.45
RAG_REWRITE_MIN_RESULTS=2
RAG_REWRITE_SHORT_QUERY_LENGTH=4
RAG_CONTEXT_MAX_CHARS=12000
RAG_MAX_CHUNKS_PER_SOURCE=3
RAG_EVALUATION_ENABLED=true
RAG_EVALUATION_DATA_DIR=data/rag_evaluation
RAG_EVALUATION_REPORT_DIR=reports/rag_evaluation
RAG_EVALUATION_MAX_CASES=100
RAG_EVALUATION_DEFAULT_TOP_K_VALUES=5,10,20
RAG_EVALUATION_REPEAT_COUNT=1
RAG_EVALUATION_FINAL_REPEAT_COUNT=3
RAG_EVALUATION_MAX_CONCURRENT_CASES=1
RAG_EVALUATION_LANGSMITH_ENABLED=true
RAG_EVALUATION_LANGSMITH_DATASET=obsidian-learning-agent-rag-eval-v1
RAG_EVALUATION_LANGSMITH_PROJECT=obsidian-learning-agent
RAG_EVALUATION_UPLOAD_SAFE_CASES_ONLY=true
RAG_EVALUATION_COLLECTION_PREFIX=rag_eval_
RAG_EVALUATION_KEEP_COLLECTIONS=3
RAG_EVALUATION_KEEP_EXPERIMENTS=20
RAG_PROMOTION_MIN_RECALL_GAIN=0.02
RAG_PROMOTION_MIN_NDCG_GAIN=0.02
RAG_PROMOTION_MAX_CITATION_DROP=0.01
RAG_PROMOTION_MAX_NO_ANSWER_DROP=0.02
RAG_PROMOTION_MAX_P95_LATENCY_INCREASE_RATIO=0.20
RAG_RETRIEVAL_PROFILE_VERSION=rag-baseline-v1
RAG_MODEL_PREWARM_ENABLED=false
RAG_MODEL_PREWARM_ON_STARTUP=false
LEARNING_SESSION_REVIEW_MAX_QA=20

SESSION_MEMORY_ENABLED=true
SESSION_MEMORY_MAX_TURNS=6
SESSION_MEMORY_MAX_CHARS=3000
SESSION_MEMORY_ANSWER_PREVIEW_CHARS=500

USER_PREFERENCES_MAX_CHARS=1000
EXPLICIT_LEARNING_CONTEXT_MAX_CHARS=1200
RAG_TOTAL_PROMPT_MAX_CHARS=18000

RUN_HISTORY_RETENTION_DAYS=10
RUN_QUESTION_PREVIEW_CHARS=200
RUN_ERROR_PREVIEW_CHARS=500

TOOL_DEFAULT_TIMEOUT_SECONDS=15
TOOL_AUDIT_INPUT_MAX_CHARS=1000
TOOL_AUDIT_OUTPUT_MAX_CHARS=1000
ENABLED_INTERNAL_TOOLS=list_learning_goals,list_learning_status,search_obsidian_notes,get_session_messages,get_user_preferences,retrieve_knowledge,list_official_sources,get_update_proposal,preview_update_diff,apply_update_proposal

MCP_ENABLED=true
MCP_CONFIG_PATH=config/mcp_servers.local.yaml
MCP_MAX_INPUT_CHARS=10000
MCP_MAX_OUTPUT_CHARS=20000
MCP_MAX_SCHEMA_CHARS=50000
MCP_MAX_TOOLS_PER_SERVER=50
MCP_DEFAULT_CONNECT_TIMEOUT_SECONDS=15
MCP_DEFAULT_TOOL_TIMEOUT_SECONDS=30
MCP_STDERR_PREVIEW_CHARS=1000

OBSIDIAN_ENABLED=false
OBSIDIAN_VAULT_PATH=
OBSIDIAN_INCLUDE_PATTERNS=*.md,**/*.md
OBSIDIAN_EXCLUDE_DIRS=.obsidian,.trash,Attachments,Templates,Archive,_ai_updates
OBSIDIAN_EXCLUDE_PATHS=Learning/_drafts
OBSIDIAN_MAX_FILE_BYTES=2097152
OBSIDIAN_CHUNK_MIN_CHARS=200
OBSIDIAN_CHUNK_TARGET_CHARS=1200
OBSIDIAN_CHUNK_MAX_CHARS=1800
OBSIDIAN_ATOMIC_BLOCK_HARD_MAX_CHARS=6000

OFFICIAL_SOURCES_ENABLED=true
OFFICIAL_FETCH_TIMEOUT_SECONDS=20
OFFICIAL_FETCH_MAX_REDIRECTS=3
OFFICIAL_FETCH_MAX_BYTES=10485760
OFFICIAL_FETCH_USER_AGENT=Obsidian-Learning-Agent/1.0
OFFICIAL_FETCH_ALLOWED_CONTENT_TYPES=text/html,text/plain,text/markdown,application/pdf
OFFICIAL_FETCH_ALLOW_LOCAL_HTTP=false
OFFICIAL_HTML_MAX_CHARS=500000
OFFICIAL_PDF_MAX_PAGES=300
OFFICIAL_SNAPSHOT_KEEP=5
NOTE_VERSION_KEEP=10
UPDATE_PROPOSAL_RETENTION_DAYS=30
OFFICIAL_AUDIT_MAX_LINKED_NOTES=10
OFFICIAL_PROPOSAL_MAX_ITEMS=10
OFFICIAL_PROPOSAL_MAX_OPERATIONS_PER_NOTE=20
OFFICIAL_PROPOSAL_MAX_CHANGE_RATIO=0.35
OFFICIAL_EVIDENCE_EXCERPT_MAX_CHARS=500
OFFICIAL_PROPOSAL_SUMMARY_MAX_CHARS=2000
APPROVAL_EXPIRES_HOURS=24
OFFICIAL_CHECKPOINT_ENABLED=true

# Optional project-local caches for future model downloads.
HF_HOME=model_cache/huggingface
TRANSFORMERS_CACHE=model_cache/huggingface/transformers
SENTENCE_TRANSFORMERS_HOME=model_cache/sentence-transformers

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=obsidian-learning-agent
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_OBSERVABILITY_ENABLED=false
LANGSMITH_SAFE_MODE=true
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_TRACE_SCHEMA_VERSION=ola-trace-v1
LANGSMITH_ENVIRONMENT=local
LANGSMITH_FLUSH_TIMEOUT_SECONDS=3
LANGSMITH_MAX_METADATA_CHARS=10000
LANGSMITH_MAX_ERROR_PREVIEW_CHARS=500
LANGSMITH_FAILURE_COOLDOWN_SECONDS=60

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
